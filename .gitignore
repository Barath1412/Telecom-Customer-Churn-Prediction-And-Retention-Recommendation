# =============================================================================
# Telecom Retention System — Comprehensive .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SECRETS & ENVIRONMENT VARIABLES (DO NOT COMMIT SECRETS / API KEYS)
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.*
**/.env
**/.env.local
**/.env.*.local
**/.env.*
*.pem
*.key
*.cert
*.p12
*.pfx
secrets/
**/secrets/
!**/.env.example
!.env.example

# -----------------------------------------------------------------------------
# 2. RUNTIME AUDIT LOGS, LIVE CACHES & EXPERIMENT RUNS
# -----------------------------------------------------------------------------
ml/artifacts/actions/
ml/artifacts/runs/
ml/artifacts/eval_random/
ml/artifacts/*.sqlite
ml/artifacts/*.sqlite-journal
ml/artifacts/*.sqlite-wal
ml/artifacts/*.sqlite-shm
ml/artifacts/*.jsonl
**/artifacts/actions/
**/artifacts/runs/
**/artifacts/*.sqlite
**/artifacts/*.jsonl

# Whitelist persistent customer upload registries so they deploy to Vercel/production
!ml/artifacts/uploaded_customers.jsonl
!ml/artifacts/uploaded_customers.json
!**/artifacts/uploaded_customers.jsonl
!**/artifacts/uploaded_customers.json

# -----------------------------------------------------------------------------
# 3. PYTHON BYTECODE, PACKAGING & VIRTUAL ENVIRONMENTS
# -----------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
**/*.egg-info/
dist/
**/dist/
build/
**/build/
eggs/
.eggs/
*.egg
venv/
.venv/
**/venv/
**/.venv/
env/
ENV/

# Testing & Linting Caches
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.pyre/
.pytype/
.ipynb_checkpoints/
**/.ipynb_checkpoints/
.coverage
htmlcov/

# -----------------------------------------------------------------------------
# 4. NODE.JS, VITE, TYPESCRIPT & FRONTEND BUILD ARTIFACTS
# -----------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

out/
.next/
.output/
.eslintcache
*.tsbuildinfo
**/*.tsbuildinfo
.vite/
**/.vite/
.cache/
**/.cache/
.turbo/
.parcel-cache/

# Frontend Test Coverage
coverage/
**/coverage/
.vitest/
.nyc_output/
playwright-report/
test-results/

# -----------------------------------------------------------------------------
# 5. LOG FILES
# -----------------------------------------------------------------------------
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -----------------------------------------------------------------------------
# 6. OPERATING SYSTEM & IDE CONFIGURATIONS
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# Audit & Scratch Reports
FRONTEND_AUDIT_REPORT.md
**/FRONTEND_AUDIT_REPORT.md
