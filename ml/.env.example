# Copy this file to .env and put your real key in it.  .env must never be committed.
#
#   cp .env.example .env
#   # then edit .env and paste your key after the = sign
#
# Get a key from https://aistudio.google.com/apikey

GEMINI_API_KEY=paste-your-key-here

# fake   = no network, no key, deterministic. The default for tests and demos.
# gemini = real calls to gemini-3.5-flash-lite. Needs the key above.
NARRATION_PROVIDER=fake
